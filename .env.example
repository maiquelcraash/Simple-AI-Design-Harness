# Rename this file to .env and fill in your API keys

# AI Design Harness - Environment Configuration

# Provider: kiro | ollama-cli | ollama-http | openai
AI_PROVIDER=ollama-cli

# Model name (provider-specific, overridden per provider script)
AI_MODEL=gemma4:e4b

# Base URL for Ollama HTTP provider
AI_BASE_URL=http://localhost:11434/v1
# API key (required for openai provider)
AI_API_KEY=

# OPENAI
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=

# --- Image Generation Subagent ---
# Configure a separate model for the image-generation subagent.
# If IMAGE_SUBAGENT_PROVIDER is unset, the tool uses mock prompt refinement.
IMAGE_SUBAGENT_PROVIDER=
IMAGE_SUBAGENT_MODEL=
IMAGE_SUBAGENT_BASE_URL=
IMAGE_SUBAGENT_API_KEY=

# Generation parameters
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4096

# Debug mode (true/false)
DEBUG=false
